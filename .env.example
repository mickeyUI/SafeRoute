# Copy this file to .env and replace placeholders. Never commit real secrets.

# --- Application -------------------------------------------------------------
APP_NAME=SafeRoute
APP_ENV=local                 # local | test | staging | production
DEBUG=true
VERSION=0.1.0
API_V1_PREFIX=/api/v1

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-with-a-random-32-byte-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database ----------------------------------------------------------------
# Matches docker-compose.yml. Use postgresql+psycopg for psycopg 3.
DATABASE_URL=postgresql+psycopg://saferoute:saferoute@localhost:5432/saferoute
DB_ECHO=false

# --- CORS --------------------------------------------------------------------
# Comma-separated origins for the future Expo web/mobile client.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,exp://localhost:8081

# --- Routing -----------------------------------------------------------------
# stub | graphhopper | osrm
ROUTING_PROVIDER=stub
ROUTING_ALTERNATIVES=3
ROUTING_TIMEOUT_SECONDS=5

# Only required when ROUTING_PROVIDER=graphhopper.
GRAPHHOPPER_URL=https://graphhopper.com/api/1/route
GRAPHHOPPER_API_KEY=

# Optional override for self-hosted OSRM.
OSRM_URL=http://router.project-osrm.org

# --- Safety scoring ----------------------------------------------------------
REPORT_MAX_AGE_DAYS=90
SAFE_LOCATION_RADIUS_M=150
DEFAULT_SEARCH_RADIUS_M=1000

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_PER_MINUTE=30
