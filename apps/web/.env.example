# Copy to .env.local. An empty API base uses the Vite dev proxy / same origin.
VITE_API_BASE_URL=
VITE_GEOCODING_ENDPOINT=https://photon.komoot.io/api/

# The web demo creates/reuses this account automatically for reports and SOS.
VITE_DEMO_EMAIL=demo@safaroute.local
VITE_DEMO_PASSWORD=demo-pass-123
