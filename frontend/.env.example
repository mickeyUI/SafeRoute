# SafeRoute Environment Configuration Example
# Deployed Render Backend API
VITE_API_BASE_URL=https://saferoute-ezbz.onrender.com/api/v1
VITE_GEOCODING_ENDPOINT=https://photon.komoot.io/api/
VITE_ROUTING_ENDPOINT=https://router.project-osrm.org/route/v1/driving

# Optional: public origin used in SMS/share links. Set this to the deployed
# frontend URL so recipients do not receive http://localhost:5173/... links.
# VITE_PUBLIC_APP_ORIGIN=https://saferoute-frontend.onrender.com

# Optional (local development only): point the Vite /api proxy at a local
# backend instead of the Render service above.
# VITE_BACKEND_TARGET=http://127.0.0.1:8000
